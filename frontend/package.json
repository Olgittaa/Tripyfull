{
  "name": "tripyfull-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "lib/*",
    "app/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @tripyfull/portal",
    "dev:portal": "npm run dev -w @tripyfull/portal",
    "dev:styleguide": "npm run dev -w @tripyfull/dev",
    "build": "npm run build -w @tripyfull/portal && npm run build -w @tripyfull/dev",
    "build:portal": "npm run build -w @tripyfull/portal",
    "build:styleguide": "npm run build -w @tripyfull/dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.0",
    "prettier": "^3.9.5",
    "vite": "^8.0.3"
  }
}
