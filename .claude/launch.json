{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/dev-backend.mjs"
      ],
      "port": 8080
    },
    {
      "name": "portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "styleguide",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:styleguide",
        "--prefix",
        "frontend"
      ],
      "port": 4001
    }
  ]
}
