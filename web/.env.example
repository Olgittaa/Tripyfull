# Copy to .env.local. The portal that embeds this chat in an iframe — the only site
# allowed to frame it and the only one that receives its postMessage events.
NEXT_PUBLIC_PORTAL_ORIGIN=http://localhost:5173

# Server-only (no NEXT_PUBLIC_ prefix): never sent to the browser.
# Anthropic API key — https://console.anthropic.com → API keys. Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional: the model behind the chat (default claude-haiku-5-5).
# "mock" = a fake model streaming a canned reply: free, no key needed.
# CHAT_MODEL=mock
