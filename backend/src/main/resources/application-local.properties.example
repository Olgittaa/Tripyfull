# Copy this file to `application-local.properties` and fill in your own values.
# The real file is gitignored — never commit secrets.

spring.datasource.url=jdbc:postgresql://localhost:5432/tripdb
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Must be at least 32 characters.
jwt.secret=CHANGE_ME_local-dev-secret-min-32-chars

# AeroDataBox (RapidAPI) — get your own key at https://rapidapi.com
aerodatabox.api-key=CHANGE_ME

# Optional: OpenTripMap attraction enrichment (Wikipedia descriptions + photos on saved
# places). Free non-commercial key at https://dev.opentripmap.org — remove to disable.
opentripmap.api-key=CHANGE_ME
